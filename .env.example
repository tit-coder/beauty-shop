# ===================================================================
# BEAUTY SHOP - CẤU HÌNH BIẾN MÔI TRƯỜNG (.env.example)
# ===================================================================

# 1. Cấu hình máy chủ & Cơ sở dữ liệu MySQL
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=beauty_shop
DB_USER=root
DB_PASS=

# 2. Cấu hình ứng dụng
APP_NAME="Beauty Cosmetics"
APP_URL=http://localhost:8000
APP_ENV=development

# 3. Cấu hình AI Beauty Advisor (Google Gemini API)
# Lấy API key miễn phí tại: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE
GEMINI_MODEL=gemini-1.5-flash

